{
  "name": "lamplight",
  "version": "0.1.0",
  "description": "타자기 감성의 회의록 — 직접 타이핑하고, 녹음하고, 램프 아래에서 읽는다",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:native": "node scripts/prepare-dev.js",
    "postinstall": "node scripts/prepare-dev.js",
    "dist": "node scripts/prepare-dev.js && electron-builder --mac dmg --arm64 --x64 -c.mac.identity=-",
    "release": "node scripts/prepare-dev.js && electron-builder --mac dmg --arm64 --x64 -c.mac.notarize=true"
  },
  "author": "designzeroplus-pro",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/nanum-gothic-coding": "^5.3.0",
    "fix-webm-duration": "^1.0.6"
  },
  "productName": "Lamplight",
  "private": true,
  "build": {
    "appId": "com.lamplight.notes",
    "productName": "Lamplight",
    "files": [
      "main.js",
      "preload.js",
      "ai.js",
      "chatgpt.js",
      "src/**",
      "node_modules/@fontsource/**",
      "node_modules/fix-webm-duration/**",
      "node_modules/@anthropic-ai/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "회의를 녹음하기 위해 마이크 접근이 필요합니다.",
        "NSSpeechRecognitionUsageDescription": "회의 녹음을 실시간으로 받아 적기 위해 음성 인식이 필요합니다."
      },
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "native/bin/lamplight-transcriber",
        "to": "bin/lamplight-transcriber"
      }
    ],
    "dmg": {
      "title": "Lamplight",
      "iconSize": 96
    },
    "electronLanguages": [
      "ko",
      "en"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/designzeroplus-pro/lamplight.git"
  },
  "homepage": "https://github.com/designzeroplus-pro/lamplight"
}
